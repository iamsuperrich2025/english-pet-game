#!/bin/sh
# ============================================================
# 🚦 กฎทองข้อ 10 (ต่อ) — กัน "เลขรอบชนกับ session คู่ขนาน"
# เคสจริงรอบ 505: อีก session ลง "รอบ 505" บน main ระหว่างที่ session นี้กำลังทำ
#
# ตรรกะ "รอบไหนชน" อยู่ที่ tools/check_parallel.sh (โหมด round) → rotate_handoff.py จุดเดียว
#   (รวมทั้ง guard กัน rotate_handoff.py เวอร์ชันเก่า และการหา python)
# hook นี้ทำแค่: ดึงเลขรอบจากหัวข้อ commit → ส่งให้ check_parallel.sh
# ข้ามชั่วคราว: SKIP_PARALLEL_CHECK=1 git commit ...
# ============================================================
[ -n "$SKIP_PARALLEL_CHECK" ] && exit 0

MSG=$1
[ -f "$MSG" ] || exit 0

# เลขรอบที่กำลังจะ commit = เลขในรูปแบบหัวข้อ "รอบ N:" ที่ "ขึ้นต้นบรรทัด" เท่านั้น
# 🐞 รอบ 1002 (เจอตอน commit จริง 2 ชั้น):
#   ① เดิมใช้ sed 's/.*รอบ \(...\)/' ซึ่ง `.*` เป็น greedy → ได้ "เลขสุดท้าย" ไม่ใช่เลขแรกตามคอมเมนต์
#      หัวข้อ "รอบ 1002: ... ก่อนรอบ 881 ... รอบ 999 ..." จึงถูกอ่านเป็น 999 แล้วบล็อกทั้งที่เลขจริง 1002
#   ② พอแก้เป็น "เลขแรก" ก็ยังพลาดกับ commit handoff ที่ finish_round.sh สร้าง — ข้อความขึ้นต้น
#      "handoff: ..." แล้วมี "ก่อนรอบ 881" กลางประโยค → จับ 881 มาเช็คทั้งที่ไม่ใช่รอบใหม่เลย
#   → ยึด "^รอบ N:" อย่างเดียว: commit รอบจริงถูกเช็คครบเหมือนเดิม · commit handoff/อื่น ๆ ข้ามไป (exit 0)
mine=$(head -1 "$MSG" | sed -n 's/^รอบ \([0-9]\{1,\}\):.*/\1/p')
[ -n "$mine" ] || exit 0

rpt=$(sh tools/check_parallel.sh round "$mine" 2>/dev/null); rc=$?
if [ "$rc" != 0 ] && [ -n "$rpt" ]; then
  printf '\n%s\n' "$rpt" >&2
  printf '\n   (ตั้งใจข้ามจริง ๆ: SKIP_PARALLEL_CHECK=1 git commit ...)\n\n' >&2
  exit 1
fi
exit 0
