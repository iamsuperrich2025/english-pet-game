#!/bin/sh
# ============================================================
# 🚦 กฎทองข้อ 10 — กัน "commit ทับงาน session คู่ขนาน"
# ตรรกะทั้งหมดอยู่ที่ tools/check_parallel.sh (โหมด pre-commit) — ที่เดียว ใช้ร่วม SessionStart
#   ① main มี commit ที่ HEAD ยังไม่มี      → ต้อง rebase ก่อน (ไม่งั้นวัดผลบนโค้ดคนละชุด)
#   ② version.json (staged) ไม่ใหม่กว่าของ main → เลข deploy ชนกัน
# ข้ามชั่วคราว: SKIP_PARALLEL_CHECK=1 git commit ...
# ปิดถาวร: git config --unset core.hooksPath
# ============================================================
[ -n "$SKIP_PARALLEL_CHECK" ] && exit 0

rpt=$(sh tools/check_parallel.sh pre-commit 2>/dev/null); rc=$?
if [ "$rc" != 0 ] && [ -n "$rpt" ]; then
  printf '\n%s\n' "$rpt" >&2
  printf '\n   (ตั้งใจข้ามจริง ๆ: SKIP_PARALLEL_CHECK=1 git commit ...)\n\n' >&2
  exit 1
fi
exit 0
